# VenueVue POS - front-end environment (Vite)
#
# Copy this file to `.env` and adjust for your LAN deployment.
#
# The front-end reads this through `import.meta.env.VITE_API_BASE_URL`
# (see src/context/AuthContext.jsx) and prefixes every API call with it.
#
# Default: the PHP API served by XAMPP on this machine, which is what
# `npm run dev` talks to.
VITE_API_BASE_URL=http://localhost:8000/backend

# For a LAN deployment where Apache serves BOTH the built assets and the PHP
# from http://192.168.137.1, comment the line above and leave the value EMPTY
# instead - an empty value means "same-origin requests" (no CORS pre-flight):
#
#   VITE_API_BASE_URL=
